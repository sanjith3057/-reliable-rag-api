# Copy to .env and fill in one API key. Every setting in app/config.py can be overridden here.

# LLM: groq | gemini | openai | fake  (fake needs no key and answers by quoting the top source)
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Leave empty for the provider default (groq: openai/gpt-oss-120b)
LLM_MODEL=
# Tried in order while the main model is rate limited, comma-separated
# (groq default: openai/gpt-oss-20b,qwen/qwen3.8-27b)
LLM_FALLBACK_MODEL=
# Only sent to models that accept it (gpt-oss). Keeps answers short, valid and cheap.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# Retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5
# Abstention gate, as cosine similarity. Loose on purpose: it only stops clearly off-topic questions.
SIMILARITY_THRESHOLD=0.40

# Second-stage retrieval. The reranker is on by default; BM25 fusion is optional (see docs/EVALUATION.md).
ENABLE_HYBRID=false
ENABLE_RERANKER=true

# Scanned PDFs. Pages with no text layer are read with a local OCR model, a few seconds a page.
ENABLE_OCR=true
MAX_OCR_PAGES=25
# Optional: send a page the local OCR is unsure of (handwriting, bad photos) to a vision model at
# the LLM provider. Off by default: the page image then leaves your machine.
OCR_VISION_FALLBACK=false
OCR_VISION_MODEL=qwen/qwen3.8-27b
OCR_MIN_CONFIDENCE=0.85

# Security
# Empty = the API is open, which is fine on localhost. Set a long random value before exposing
# the server; clients then send it in the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Optional second key that can only ask questions and list documents (no upload, delete or evaluation).
READ_API_KEY=
# Number of reverse proxies in front of the app. 0 = ignore X-Forwarded-For. Set 1 behind nginx or a load balancer.
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ASK_PER_MIN=30
RATE_LIMIT_INGEST_PER_MIN=20
RATE_LIMIT_EVAL_PER_MIN=3
RATE_LIMIT_DEFAULT_PER_MIN=120

# Storage
CHROMA_PATH=chroma_data
